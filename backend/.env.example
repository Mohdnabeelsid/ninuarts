APP_NAME="Ninu Arts Business Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Local SQLite (Default for local studio run):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# MySQL (Production VPS / Managed MySQL):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ninu_arts_db
DB_USERNAME=ninu_arts_user
DB_PASSWORD=change_me_strong_password

# PostgreSQL (Render + Supabase / Neon):
# DB_CONNECTION=pgsql
# DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Restrict CORS origins in production (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DRIVER=file
SESSION_LIFETIME=120
